{
    "name": "streams/testing",
    "description": "Testing support for Laravel Streams packages.",
    "type": "streams-addon",
    "license": "MIT",
    "prefer-stable": true,
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Ryan Thompson",
            "email": "ryan@pyrocms.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "orchestra/testbench": "^8.36|^9.0|^10.0|^11.0",
        "streams/core": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25"
    },
    "autoload": {
        "psr-4": {
            "Streams\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Streams\\Testing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev",
            "dev-1.0": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Streams\\Testing\\TestServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
